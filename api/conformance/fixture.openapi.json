  "components": {
    "schemas": {
      "FieldError": {
        "required": ["code", "field", "location", "message"],
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "The field's wire name; in a body, a dotted camelCase path with indexes, such as `address.city` or `tags[2]`."
          },
          "location": {
            "enum": ["body", "query", "path", "header"],
            "type": "string",
            "description": "Where the field is."
          },
          "code": {
            "type": "string",
            "description": "What is wrong, such as `required` or `too_long`."
          },
          "message": {
            "type": "string",
            "description": "An English sentence describing the problem, safe to show."
          }
        },
        "description": "One problem with one field of the request."
      },
      "FixtureColor": {
        "enum": ["blue", "red"],
        "type": "string",
        "description": "A fixture widget's color. A newer server may send others."
      },
      "FixtureCreateWidgetRequest": {
        "required": ["name"],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The widget's name."
          },
          "color": {
            "enum": ["blue", "red"],
            "type": "string",
            "description": "The widget's color."
          }
        },
        "description": "A fixture widget to create."
      },
      "FixtureUpdateWidgetRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The new name; it can't be cleared."
          },
          "nickname": {
            "type": ["string", "null"],
            "description": "The new nickname, or null to clear it."
          },
          "tags": {
            "type": ["array", "null"],
            "items": {
              "type": "string"
            },
            "description": "The new tags, replacing the old ones whole, or null to clear them."
          }
        },
        "additionalProperties": false,
        "description": "A partial update of a fixture widget."
      },
      "FixtureWidgetResponse": {
        "required": ["color", "createdAt", "id", "name"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The widget's ID."
          },
          "name": {
            "type": "string",
            "description": "The widget's name."
          },
          "color": {
            "$ref": "#/components/schemas/FixtureColor"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the widget was created, UTC."
          }
        },
        "description": "A fixture widget."
      },
      "HealthResponse": {
        "required": ["apiVersions", "status"],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok`."
          },
          "apiVersions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The API versions the server serves, `YYYY-MM-DD`; send one in `Orvano-Api-Version`."
          }
        },
        "description": "The server is up and ready to serve requests."
      },
      "PageOfFixtureWidgetResponse": {
        "required": ["items", "nextCursor", "total"],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FixtureWidgetResponse"
            },
            "description": "The items on this page, in the list's order."
          },
          "nextCursor": {
            "type": ["string", "null"],
            "description": "The cursor for the next page, or null on the last page."
          },
          "total": {
            "type": ["integer", "null"],
            "description": "How many items the whole list has, or null when the operation does not count them.",
            "format": "int32"
          }
        },
        "description": "One page of a list."
      },
      "Problem": {
        "required": ["code", "detail", "status", "title", "traceId", "type"],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Always `about:blank`: the code is the error's identity."
          },
          "title": {
            "type": "string",
            "description": "The HTTP reason phrase, such as `Not Found`."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status.",
            "format": "int32"
          },
          "detail": {
            "type": "string",
            "description": "An English message safe to show to the user."
          },
          "code": {
            "type": "string",
            "description": "The snake_case error code; x-orvano-error-codes lists every code."
          },
          "traceId": {
            "type": "string",
            "description": "Equals the `Orvano-Request-Id` header."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "description": "On `validation_failed`: each field that is not valid."
          },
          "retryAfter": {
            "type": "integer",
            "description": "On a 429 or a 503 that knows when to come back: seconds to wait, equal to `Retry-After`.",
            "format": "int32"
          },
          "requiredRole": {
            "type": "string",
            "description": "On a console 403: the console role that would allow the action."
          },
          "currentVersion": {
            "type": "string",
            "description": "On `version_conflict`: the resource's current version, as its `ETag` without quotes."
          },
          "supportedVersions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "On `unsupported_api_version`: the versions the server serves."
          }
        },
        "description": "The error body of every non 2xx response (RFC 9457 problem details). `code` identifies the error."
      }
    },
    "parameters": {
      "Authorization": {
        "name": "Authorization",
        "in": "header",
        "description": "`Bearer <access token>` for a signed in end user.",
        "schema": {
          "type": "string"
        }
      },
      "Idempotency-Key": {
        "name": "Idempotency-Key",
        "in": "header",
        "description": "1 to 255 printable ASCII characters that make a retried request safe, on operations marked `x-orvano-idempotent`.",
        "schema": {
          "type": "string"
        }
      },
      "If-Match": {
        "name": "If-Match",
        "in": "header",
        "description": "The `ETag` of the version you read. A write to a changed resource answers `412 version_conflict`.",
        "schema": {
          "type": "string"
        }
      },
      "Orvano-Api-Version": {
        "name": "Orvano-Api-Version",
        "in": "header",
        "description": "The API version the client was built for, `YYYY-MM-DD`. Without it the server uses its current version.",
        "schema": {
          "type": "string"
        }
      },
      "Orvano-Client": {
        "name": "Orvano-Client",
        "in": "header",
        "description": "The SDK and its version, `<package>/<version>`. Used for telemetry only.",
        "schema": {
          "type": "string"
        }
      },
      "Orvano-Csrf": {
        "name": "Orvano-Csrf",
        "in": "header",
        "description": "The console session's CSRF token, on requests that change state.",
        "schema": {
          "type": "string"
        }
      },
      "Orvano-Key": {
        "name": "Orvano-Key",
        "in": "header",
        "description": "The project's publishable (`orv_pk_…`) or secret (`orv_sk_…`) key.",
        "schema": {
          "type": "string"
        }
      },
      "traceparent": {
        "name": "traceparent",
        "in": "header",
        "description": "W3C trace context, to join the request to your trace.",
        "schema": {
          "type": "string"
        }
      },
      "tracestate": {
        "name": "tracestate",
        "in": "header",
        "description": "W3C trace state, sent with `traceparent`.",
        "schema": {
          "type": "string"
        }
      }
    },
    "headers": {
      "ETag": {
        "description": "The strong ETag of the resource's version. Send it back as `If-Match` to write safely.",
        "schema": {
          "type": "string"
        }
      },
      "Orvano-Api-Version": {
        "description": "The API version the server answered with.",
        "schema": {
          "type": "string"
        }
      },
      "Orvano-Idempotent-Replayed": {
        "description": "`true` when the answer is a replay of an earlier request with the same `Idempotency-Key`.",
        "schema": {
          "type": "string"
        }
      },
      "Orvano-Request-Id": {
        "description": "The request's 32 hex character trace ID. Equals the problem body's `traceId`; quote it when you report an issue.",
        "schema": {
          "type": "string"
        }
      },
      "Retry-After": {
        "description": "Seconds to wait before trying again, on a 429 or a 503 that knows when to come back.",
        "schema": {
          "minimum": 0,
          "type": "integer",
          "format": "int32"
        }
      }
    }
  },
  "x-orvano-error-codes": {
    "conflict": {
      "status": 409,
      "description": "The request conflicts with the resource's current state."
    },
    "forbidden": {
      "status": 403,
      "description": "The caller is not allowed to do this; on a console route, requiredRole names the role that would allow it.",
      "members": ["requiredRole"]
    },
    "idempotency_in_progress": {
      "status": 409,
      "description": "A request with this idempotency key is still running (reserved)."
    },
    "idempotency_key_reused": {
      "status": 422,
      "description": "This idempotency key was used with a different request (reserved)."
    },
    "insufficient_scope": {
      "status": 403,
      "description": "The credential does not have the scope this needs."
    },
    "internal": {
      "status": 500,
      "description": "Something went wrong on the server."
    },
    "invalid_cursor": {
      "status": 400,
      "description": "The cursor does not parse, or was issued for another filter or sort."
    },
    "invalid_request": {
      "status": 400,
      "description": "The request could not be read: malformed JSON, a wrong body type, or a bad header."
    },
    "method_not_allowed": {
      "status": 405,
      "description": "The route does not accept this method."
    },
    "not_found": {
      "status": 404,
      "description": "The resource or route was not found."
    },
    "payload_too_large": {
      "status": 413,
      "description": "The request body is too large."
    },
    "rate_limited": {
      "status": 429,
      "description": "Too many requests; wait retryAfter seconds.",
      "members": ["retryAfter"]
    },
    "session_expired": {
      "status": 401,
      "description": "The access token expired; refresh the session once and retry."
    },
    "timeout": {
      "status": 503,
      "description": "The server took too long to answer."
    },
    "unauthorized": {
      "status": 401,
      "description": "The credential is missing, invalid, expired, or not for this project."
    },
    "unavailable": {
      "status": 503,
      "description": "The server cannot answer right now; retryAfter says when to come back, when known.",
      "members": ["retryAfter"]
    },
    "unsupported_api_version": {
      "status": 400,
      "description": "The Orvano-Api-Version header is malformed or not supported; supportedVersions lists the ones that are.",
      "members": ["supportedVersions"]
    },
    "unsupported_media_type": {
      "status": 415,
      "description": "The request body's content type is not accepted here."
    },
    "validation_failed": {
      "status": 400,
      "description": "A field in the request is not valid; errors lists each one.",
      "members": ["errors"]
    },
    "version_conflict": {
      "status": 412,
      "description": "If-Match does not match the resource's current version; currentVersion holds it.",
      "members": ["currentVersion"]
    }
  }
}
