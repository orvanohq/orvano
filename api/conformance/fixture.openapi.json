      "name": "Apache 2.0",
      "identifier": "Apache-2.0"
    },
    "version": "2026-10-22"
  },
  "tags": [
    {
      "name": "fixture",
      "description": "Widgets that exist only in the stub server, to prove SDK behavior before a real endpoint does."
    }
