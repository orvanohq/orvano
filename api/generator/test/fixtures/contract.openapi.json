{
  "openapi": "3.1.1",
  "info": {
    "title": "Orvano API",
    "description": "A fixture contract for the generator's snapshot tests (spec 0014 GNR-10).",
    "version": "2026-10-22"
  },
  "tags": [
    {
      "name": "widgets",
      "description": "Widgets, a fixture service with every shape the generator renders."
    },
    {
      "name": "health",
      "description": "The server's health."
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "tags": ["health"],
        "summary": "Check that the server is reachable and ready.",
        "description": "Answers 200 when ready.",
        "operationId": "Host_Health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-orvano-audience": ["client", "server"],
        "x-orvano-errors": [],
        "x-orvano-sdk": {
          "service": "health",
          "method": "get"
        }
      }
    },
    "/v1/projects/{projectId}/widgets": {
      "get": {
        "tags": ["widgets"],
        "summary": "List the widgets.",
        "description": "Answers the widgets in the project, newest first.",
        "operationId": "Fixture_ListWidgets",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The project.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "How many widgets to answer, 1 to 100.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 100
            }
          },
          {
            "name": "color",
            "in": "query",
            "description": "Only widgets of this color.",
            "schema": {
              "$ref": "#/components/schemas/WidgetColor"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "description": "Only widgets with every one of these tags.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "The nextCursor of the previous page; omit it for the first page.",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetListResponse"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-orvano-audience": ["client", "server"],
        "x-orvano-errors": [],
        "x-orvano-sdk": {
          "service": "widgets",
          "method": "list"
        },
        "x-orvano-paging": {
          "total": true
        }
      },
      "post": {
        "tags": ["widgets"],
        "summary": "Create a widget.",
        "description": "Answers 201 with the new widget. A name already in use answers `409 widget_name_taken`.",
        "operationId": "Fixture_CreateWidget",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The project.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWidgetRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetResponse"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-orvano-audience": ["client", "server"],
        "x-orvano-errors": ["widget_name_taken"],
        "x-orvano-metered": "fixture.widgets.write",
        "x-orvano-sdk": {
          "service": "widgets",
          "method": "create"
        }
      }
    },
    "/v1/projects/{projectId}/widgets/{widgetId}": {
      "get": {
        "tags": ["widgets"],
        "summary": "Read one widget.",
        "description": "",
        "operationId": "Fixture_GetWidget",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The project.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "widgetId",
            "in": "path",
            "required": true,
            "description": "The widget.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetResponse"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-orvano-audience": ["client"],
        "x-orvano-errors": [],
        "x-orvano-sdk": {
          "service": "widgets",
          "method": "get"
        }
      },
      "delete": {
        "tags": ["widgets"],
        "summary": "Delete a widget.",
        "description": "Answers 204. Deleting a widget that is gone answers `404 not_found`.",
        "operationId": "Fixture_DeleteWidget",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The project.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "widgetId",
            "in": "path",
            "required": true,
            "description": "The widget.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "OK"
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-orvano-audience": ["server"],
        "x-orvano-errors": [],
        "x-orvano-sdk": {
          "service": "widgets",
          "method": "delete"
        }
      },
      "patch": {
        "tags": ["widgets"],
        "summary": "Update a widget.",
        "description": "Changes the fields sent and leaves the rest.",
        "operationId": "Fixture_UpdateWidget",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The project.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "widgetId",
            "in": "path",
            "required": true,
            "description": "The widget.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/If-Match"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetResponse"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-orvano-audience": ["client"],
        "x-orvano-errors": ["version_conflict"],
        "x-orvano-sdk": {
          "service": "widgets",
          "method": "update"
        },
        "x-orvano-concurrency": true,
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateWidgetRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/v1/projects/{projectId}/widget-keys/rotate": {
      "post": {
        "tags": ["widgetKeys"],
        "summary": "Rotate the widget signing key.",
        "description": "Server only: a client SDK never contains it (GNR-4).",
        "operationId": "Fixture_RotateWidgetKey",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The project.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": ["string", "null"],
                    "description": "Why the key is rotated."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetKeyResponse"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-orvano-audience": ["server"],
        "x-orvano-errors": [],
        "x-orvano-sdk": {
          "service": "widgetKeys",
          "method": "rotate"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateWidgetRequest": {
        "required": ["name"],
        "type": "object",
        "description": "A new widget.",
        "properties": {
          "name": {
            "type": "string",
            "description": "The widget's name, unique in the project."
          },
          "color": {
            "$ref": "#/components/schemas/WidgetColor"
          },
          "nickname": {
            "type": ["string", "null"],
            "description": "A short name, or null for none."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Labels to filter by."
          }
        }
      },
      "FieldError": {
        "required": ["code", "field", "location", "message"],
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "The field's wire name; in a body, a dotted camelCase path with indexes, such as `address.city` or `tags[2]`."
          },
          "location": {
            "enum": ["body", "query", "path", "header"],
            "type": "string",
            "description": "Where the field is."
          },
          "code": {
            "type": "string",
            "description": "What is wrong, such as `required` or `too_long`."
          },
          "message": {
            "type": "string",
            "description": "An English sentence describing the problem, safe to show."
          }
        },
        "description": "One problem with one field of the request."
      },
      "HealthResponse": {
        "required": ["apiVersions", "status"],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok`."
          },
          "apiVersions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The API versions the server serves, `YYYY-MM-DD`; send one in `Orvano-Api-Version`."
          }
        },
        "description": "The server is up and ready to serve requests."
      },
      "Problem": {
        "required": ["code", "detail", "status", "title", "traceId", "type"],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Always `about:blank`: the code is the error's identity."
          },
          "title": {
            "type": "string",
            "description": "The HTTP reason phrase, such as `Not Found`."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status.",
            "format": "int32"
          },
          "detail": {
            "type": "string",
            "description": "An English message safe to show to the user."
          },
          "code": {
            "type": "string",
            "description": "The snake_case error code; x-orvano-error-codes lists every code."
          },
          "traceId": {
            "type": "string",
            "description": "Equals the `Orvano-Request-Id` header."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "description": "On `validation_failed`: each field that is not valid."
          },
          "retryAfter": {
            "type": "integer",
            "description": "On a 429 or a 503 that knows when to come back: seconds to wait, equal to `Retry-After`.",
            "format": "int32"
          },
          "requiredRole": {
            "type": "string",
            "description": "On a console 403: the console role that would allow the action."
          },
          "currentVersion": {
            "type": "string",
            "description": "On `version_conflict`: the resource's current version, as its `ETag` without quotes."
          },
          "supportedVersions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "On `unsupported_api_version`: the versions the server serves."
          }
        },
        "description": "The error body of every non 2xx response (RFC 9457 problem details). `code` identifies the error."
      },
      "UpdateWidgetRequest": {
        "type": "object",
        "description": "A partial update of a widget.",
        "properties": {
          "name": {
            "type": "string",
            "description": "The new name; it can't be cleared."
          },
          "nickname": {
            "type": ["string", "null"],
            "description": "The new nickname, or null to clear it."
          },
          "tags": {
            "type": ["array", "null"],
            "items": {
              "type": "string"
            },
            "description": "The new tags, replacing the old ones, or null to clear them."
          }
        }
      },
      "WidgetColor": {
        "enum": ["blue", "dark_green", "red"],
        "type": "string",
        "description": "A widget's color."
      },
      "WidgetKeyResponse": {
        "required": ["counter", "keyId"],
        "type": "object",
        "description": "A rotated key.",
        "properties": {
          "keyId": {
            "type": "string",
            "description": "The new key's ID."
          },
          "counter": {
            "type": "string",
            "format": "int64",
            "pattern": "^-?[0-9]+$",
            "description": "How many times the key was rotated, as a string (JSW-5)."
          }
        }
      },
      "WidgetListResponse": {
        "required": ["items", "nextCursor", "total"],
        "type": "object",
        "description": "Widgets.",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WidgetResponse"
            },
            "description": "The widgets."
          },
          "nextCursor": {
            "type": ["string", "null"],
            "description": "The cursor for the next page, or null on the last page."
          },
          "total": {
            "type": ["integer", "null"],
            "format": "int32",
            "description": "How many widgets there are, or null when not counted."
          }
        }
      },
      "WidgetOwnerResponse": {
        "required": ["kind", "userId"],
        "type": "object",
        "description": "Who owns a widget.",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "The owner's user ID."
          },
          "kind": {
            "enum": ["team", "user"],
            "type": "string",
            "description": "What kind of owner."
          }
        }
      },
      "WidgetResponse": {
        "required": [
          "color",
          "createdAt",
          "id",
          "labels",
          "name",
          "nickname",
          "owner",
          "size",
          "tags",
          "version"
        ],
        "type": "object",
        "description": "A widget.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The widget's ID."
          },
          "name": {
            "type": "string",
            "description": "The widget's name."
          },
          "color": {
            "$ref": "#/components/schemas/WidgetColor"
          },
          "nickname": {
            "type": ["string", "null"],
            "description": "The short name, or null."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The widget's labels."
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Free form labels by key."
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "maximum": 9007199254740991,
            "description": "The widget's size in bytes."
          },
          "owner": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/WidgetOwnerResponse"
              }
            ],
            "description": "Who owns the widget, or null."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the widget was created, UTC."
          },
          "version": {
            "type": "string",
            "readOnly": true,
            "description": "The widget's version, equal to its ETag without quotes."
          }
        }
      }
    },
    "parameters": {
      "Authorization": {
        "name": "Authorization",
        "in": "header",
        "description": "`Bearer <access token>` for a signed in end user.",
        "schema": {
          "type": "string"
        }
      },
      "Idempotency-Key": {
        "name": "Idempotency-Key",
        "in": "header",
        "description": "1 to 255 printable ASCII characters that make a retried request safe, on operations marked `x-orvano-idempotent`.",
        "schema": {
          "type": "string"
        }
      },
      "If-Match": {
        "name": "If-Match",
        "in": "header",
        "description": "The `ETag` of the version you read. A write to a changed resource answers `412 version_conflict`.",
        "schema": {
          "type": "string"
        }
      },
      "Orvano-Api-Version": {
        "name": "Orvano-Api-Version",
        "in": "header",
        "description": "The API version the client was built for, `YYYY-MM-DD`. Without it the server uses its current version.",
        "schema": {
          "type": "string"
        }
      },
      "Orvano-Client": {
        "name": "Orvano-Client",
        "in": "header",
        "description": "The SDK and its version, `<package>/<version>`. Used for telemetry only.",
        "schema": {
          "type": "string"
        }
      },
      "Orvano-Csrf": {
        "name": "Orvano-Csrf",
        "in": "header",
        "description": "The console session's CSRF token, on requests that change state.",
        "schema": {
          "type": "string"
        }
      },
      "Orvano-Key": {
        "name": "Orvano-Key",
        "in": "header",
        "description": "The project's publishable (`orv_pk_…`) or secret (`orv_sk_…`) key.",
        "schema": {
          "type": "string"
        }
      },
      "traceparent": {
        "name": "traceparent",
        "in": "header",
        "description": "W3C trace context, to join the request to your trace.",
        "schema": {
          "type": "string"
        }
      },
      "tracestate": {
        "name": "tracestate",
        "in": "header",
        "description": "W3C trace state, sent with `traceparent`.",
        "schema": {
          "type": "string"
        }
      }
    },
    "headers": {
      "ETag": {
        "description": "The strong ETag of the resource's version. Send it back as `If-Match` to write safely.",
        "schema": {
          "type": "string"
        }
      },
      "Orvano-Api-Version": {
        "description": "The API version the server answered with.",
        "schema": {
          "type": "string"
        }
      },
      "Orvano-Idempotent-Replayed": {
        "description": "`true` when the answer is a replay of an earlier request with the same `Idempotency-Key`.",
        "schema": {
          "type": "string"
        }
      },
      "Orvano-Request-Id": {
        "description": "The request's 32 hex character trace ID. Equals the problem body's `traceId`; quote it when you report an issue.",
        "schema": {
          "type": "string"
        }
      },
      "Retry-After": {
        "description": "Seconds to wait before trying again, on a 429 or a 503 that knows when to come back.",
        "schema": {
          "minimum": 0,
          "type": "integer",
          "format": "int32"
        }
      }
    }
  },
  "x-orvano-error-codes": {
    "conflict": {
      "status": 409,
      "description": "The request conflicts with the resource's current state."
    },
    "forbidden": {
      "status": 403,
      "description": "The caller is not allowed to do this; on a console route, requiredRole names the role that would allow it.",
      "members": ["requiredRole"]
    },
    "idempotency_in_progress": {
      "status": 409,
      "description": "A request with this idempotency key is still running (reserved)."
    },
    "idempotency_key_reused": {
      "status": 422,
      "description": "This idempotency key was used with a different request (reserved)."
    },
    "insufficient_scope": {
      "status": 403,
      "description": "The credential does not have the scope this needs."
    },
    "internal": {
      "status": 500,
      "description": "Something went wrong on the server."
    },
    "invalid_cursor": {
      "status": 400,
      "description": "The cursor does not parse, or was issued for another filter or sort."
    },
    "invalid_request": {
      "status": 400,
      "description": "The request could not be read: malformed JSON, a wrong body type, or a bad header."
    },
    "method_not_allowed": {
      "status": 405,
      "description": "The route does not accept this method."
    },
    "not_found": {
      "status": 404,
      "description": "The resource or route was not found."
    },
    "payload_too_large": {
      "status": 413,
      "description": "The request body is too large."
    },
    "rate_limited": {
      "status": 429,
      "description": "Too many requests; wait retryAfter seconds.",
      "members": ["retryAfter"]
    },
    "session_expired": {
      "status": 401,
      "description": "The access token expired; refresh the session once and retry."
    },
    "timeout": {
      "status": 503,
      "description": "The server took too long to answer."
    },
    "unauthorized": {
      "status": 401,
      "description": "The credential is missing, invalid, expired, or not for this project."
    },
    "unavailable": {
      "status": 503,
      "description": "The server cannot answer right now; retryAfter says when to come back, when known.",
      "members": ["retryAfter"]
    },
    "unsupported_api_version": {
      "status": 400,
      "description": "The Orvano-Api-Version header is malformed or not supported; supportedVersions lists the ones that are.",
      "members": ["supportedVersions"]
    },
    "unsupported_media_type": {
      "status": 415,
      "description": "The request body's content type is not accepted here."
    },
    "validation_failed": {
      "status": 400,
      "description": "A field in the request is not valid; errors lists each one.",
      "members": ["errors"]
    },
    "version_conflict": {
      "status": 412,
      "description": "If-Match does not match the resource's current version; currentVersion holds it.",
      "members": ["currentVersion"]
    },
    "widget_name_taken": {
      "status": 409,
      "description": "Another widget in the project has this name."
    }
  }
}
