  "paths": {
    "/v1/Widgets": {
      "get": {
        "tags": ["widgets"],
        "summary": "List widgets.",
        "operationId": "listWidgets",
        "parameters": [
          {
            "name": "X-Trace",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Count": {
                "description": "A count.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          }
        },
        "x-orvano-sdk": {
          "service": "widgets",
          "method": "list"
        }
      },
      "post": {
        "tags": ["widgets"],
        "summary": "Create a widget.",
        "description": "Creates a widget.",
        "operationId": "Widgets_Create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Widget"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          }
        },
        "x-orvano-sdk": {
          "service": "widgets",
          "method": "list"
        },
        "x-orvano-audience": ["server"],
        "x-orvano-errors": ["widget_missing"]
      }
    },
    "/v1/gadgets": {
      "get": {
        "tags": ["widgets"],
        "summary": "List gadgets.",
        "description": "Returns every gadget at once, unpaged (PAG-7).",
        "operationId": "Gadgets_List",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "description": "The gadgets.",
                  "items": {
                    "$ref": "#/components/schemas/Widget"
                  }
                }
              }
            }
          }
        },
        "x-orvano-sdk": {
          "service": "gadgets",
          "method": "list"
        },
        "x-orvano-audience": ["server"],
        "x-orvano-errors": []
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "The error body."
      },
      "Widget": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string",
            "description": "The name."
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "description": "The size."
          },
          "count": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "widgets",
      "description": "Widgets."
    }
  ],
  "x-orvano-error-codes": {
    "not_found": {
      "status": 404,
      "description": "Not found."
    }
  }
