{
  "name": "@orvano/console",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "extract": "lingui extract --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size-entries.mjs && size-limit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lingui/core": "^6.9.1",
    "@lingui/react": "^6.9.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/types": "^8.0.6",
    "@lingui/babel-plugin-lingui-macro": "^6.9.1",
    "@lingui/cli": "^6.9.1",
    "@lingui/vite-plugin": "^6.9.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@size-limit/file": "14.2.0",
    "@tanstack/router-plugin": "^1.168.46",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "playwright": "^1.64.1",
    "size-limit": "14.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vitest-browser-react": "^2.3.0"
  }
}
