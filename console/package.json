{
  "name": "@orvano/console",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/main.tsx",
    "./src/gallery/main.tsx",
    "./src/shared/zod.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "extract": "lingui extract --clean",
    "api:gen": "openapi-typescript ../api/console.openapi.json --output src/shared/api/schema.gen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:stack": "playwright test --config playwright.stack.config.ts",
    "size": "node scripts/size-entries.mjs && size-limit",
    "test:coverage": "vitest run --coverage --browser.name=chromium",
    "test:engines": "vitest run --project \"ui (firefox)\" --project \"ui (webkit)\""
  },
  "dependencies": {
    "@lingui/core": "^6.10.1",
    "@lingui/react": "^6.10.1",
    "@react-aria/live-announcer": "^3.5.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "lucide-react": "^1.62.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/types": "^8.0.8",
    "@lingui/babel-plugin-lingui-macro": "^6.10.1",
    "@lingui/cli": "^6.10.1",
    "@lingui/vite-plugin": "^6.10.1",
    "@playwright/test": "^1.64.1",
    "@react-aria/optimize-locales-plugin": "^2.1.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "msw": "^3.0.3",
    "openapi-msw": "^2.1.0",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.64.1",
    "size-limit": "14.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
}
