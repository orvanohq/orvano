{
  // Spec 0003 WEB-4: the tool configs and the Playwright tests (DOM, for the code they run in the page).
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "lingui.config.ts",
    "playwright.config.ts",
    "playwright.stack.config.ts",
    "e2e"
  ]
}
