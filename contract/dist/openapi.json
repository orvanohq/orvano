{
  "openapi": "3.1.0",
  "info": {
    "title": "Orvano",
    "version": "0.0.0",
    "description": "The Orvano API. Every path lives under /v1."
  },
  "tags": [
    {
      "name": "health"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "health.get",
        "description": "Checks that the server is up and returns its version.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ],
        "x-orvano-service": "health",
        "x-orvano-audience": "both"
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok` when the server answers.",
            "examples": [
              "ok"
            ]
          },
          "version": {
            "type": "string",
            "description": "The Orvano server version, major.minor.patch.",
            "examples": [
              "0.4.2"
            ]
          }
        },
        "description": "Whether the server is up, and which Orvano version it runs."
      }
    }
  }
}
