# Every variable the reference compose reads (spec 0007 INS-3). `orvano init` writes a real .env for you;
# this file holds no usable secrets (spec 0006 SCR-5). Never commit your .env or root.key.

# Which Caddy runs (spec 0016 LCL-2): `server` for a real domain with HTTPS, `local` for http://localhost on this
# machine only. Switching an install between them is not supported; install again instead.
COMPOSE_PROFILES=server

# The domain Caddy gets a certificate for (`localhost` in local mode), and the URL clients use to reach Orvano.
ORVANO_DOMAIN=orvano.example.com
ORVANO_PUBLIC_URL=https://orvano.example.com

# The image version this install runs, pinned by init to the image it ran from (spec 0016 PIN-2). `compose pull`
# never changes it. Moving versions is a hand edit for now; migrate runs on every `up`, and moving back is not supported.
ORVANO_VERSION=sha-0000000000000000000000000000000000000000
# The image repository, only when it is not the default (a mirror, or a local build).
# ORVANO_IMAGE=ghcr.io/orvanohq/orvano

# Local mode only: the port on 127.0.0.1 Caddy publishes, when not 80 (server mode always uses 80 and 443).
# ORVANO_HTTP_PORT=8080
# Local mode only: lets the session cookie work over plain HTTP on localhost (spec 0006 CON-1).
# ORVANO_INSECURE_COOKIES=true

# PostgreSQL superuser, used only by the postgres container itself.
POSTGRES_PASSWORD=
# The platform owner role `orvano` (spec 0007 PG-2a).
ORVANO_DB_PASSWORD=
# The `orvano_provisioner` role that creates project databases (spec 0007 PG-2).
ORVANO_PROVISIONER_PASSWORD=

# Server settings you may add to the orvano service's environment (spec 0002 CFG-2; any key also takes _FILE):
#   ORVANO_ROLES=api,worker                  roles this process runs (spec 0007 RUN-2)
#   ORVANO_DATABASE__POOLSIZE=30             platform pool size (spec 0007 PG-4)
#   ORVANO_DATABASE__SSLMODE=Prefer          TLS to PostgreSQL
#   ORVANO_TLS__CERTFILE / ORVANO_TLS__KEYFILE   PEM files for Kestrel's own HTTPS on 8443, without Caddy (TLS-2)
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317   send traces, metrics, and logs over OTLP
