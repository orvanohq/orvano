# Settings for compose.yaml. Copy to .env (which git ignores) and fill in. From this folder:
#   cp .env.example .env && echo "POSTGRES_PASSWORD=$(openssl rand -hex 32)" >> .env

# Required. The password of the bundled Postgres. Letters and digits only (it goes inside a connection string).
# POSTGRES_PASSWORD=

# Required. The image tag to run.
ORVANO_VERSION=0.1.0-dev

# Optional. The domain Caddy serves. Default: localhost, with a certificate from Caddy's own local authority.
# ORVANO_DOMAIN=localhost
