# The installer (spec 0006) writes .env next to docker-compose.yml and fills every key below. To run
# the compose file by hand instead, copy this file to .env and fill it in.
# Generate each password with: openssl rand -hex 24

# https://<your domain>, or http://localhost (not for production).
ORVANO_PUBLIC_URL=http://localhost
# Optional Let's Encrypt account email; empty is allowed.
ORVANO_ACME_EMAIL=
# The image tag to run. The installer sets it to the version it installed.
ORVANO_VERSION=dev

POSTGRES_PASSWORD=
ORVANO_ADMIN_PASSWORD=
ORVANO_APP_PASSWORD=

# Secret encryption keys, "id:base64" pairs separated by commas; the first is active.
# Generate one with: echo "k$(date -u +%Y%m%d):$(openssl rand -base64 32)"
# Back it up: losing it makes stored secrets unrecoverable.
ORVANO_MASTER_KEYS=

# The one time token that lets the first console account be created (the installer prints it as
# the setup link). "ost_" plus 43 base64url characters:
#   echo "ost_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
ORVANO_SETUP_TOKEN=

# Postgres memory settings. The installer sets them from the server's memory on every run; set
# ORVANO_PG_TUNING=manual to keep your own values. Without them the compose file uses spec 0002's
# values for a 4 GB server.
# ORVANO_PG_TUNING=manual
# ORVANO_PG_SHARED_BUFFERS=512MB
# ORVANO_PG_EFFECTIVE_CACHE_SIZE=1536MB
# ORVANO_PG_WORK_MEM=8MB
# ORVANO_PG_MAINTENANCE_WORK_MEM=128MB
# ORVANO_PG_MEMORY_LIMIT=1280M

# Optional
# ORVANO_EVENT_RETENTION_DAYS=7
# Days a deleted project or org can be restored before it is purged, 0 to 90.
# ORVANO_DELETE_GRACE_DAYS=7
# Which peers may set X-Forwarded-For: private (default; only Caddy reaches the api), none, or CIDR ranges.
# ORVANO_TRUSTED_PROXIES=private
# OTEL_EXPORTER_OTLP_ENDPOINT=
