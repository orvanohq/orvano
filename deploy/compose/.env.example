# Copy to .env next to docker-compose.yml. The installer (scope row 6) will generate these.
# Generate each password with: openssl rand -hex 24

ORVANO_PUBLIC_URL=http://localhost

POSTGRES_PASSWORD=
ORVANO_ADMIN_PASSWORD=
ORVANO_APP_PASSWORD=

# Secret encryption keys, "id:base64" pairs separated by commas; the first is active.
# Not read yet. Back it up: losing it makes stored secrets unrecoverable.
ORVANO_MASTER_KEYS=

# Optional
# ORVANO_VERSION=dev
# ORVANO_EVENT_RETENTION_DAYS=7
# OTEL_EXPORTER_OTLP_ENDPOINT=
