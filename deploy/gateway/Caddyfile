# The only public entry point (spec 0002, request routing). ORVANO_PUBLIC_URL is the site
# address: https://orvano.example.com gets automatic HTTPS, http://localhost stays plain HTTP.

{
	# The Let's Encrypt account email, written at start by entrypoint.sh (spec 0006, AC-7).
	import /etc/caddy/global.caddy

	# Let's Encrypt only (spec 0006, AC-1). Caddy's default adds ZeroSSL as a fallback CA.
	cert_issuer acme {
		dir https://acme-v02.api.letsencrypt.org/directory
	}
}

{$ORVANO_PUBLIC_URL} {
	encode zstd gzip

	# HTTPS installs only (spec 0006, AC-26). No includeSubDomains: other subdomains may not be Orvano's.
	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000"

	# Never proxied. Internal calls such as the on demand TLS `ask` go straight to api:8080.
	handle /internal/* {
		respond 404
	}

	handle /v1/realtime {
		reverse_proxy realtime:8080
	}

	handle /v1/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv/console

		# Every console file (spec 0005, Security headers): scripts and styles only from the
		# console's own origin, no framing, no MIME sniffing. The one style hash is Base UI's scrollbar
		# style for select popups (console/design.md, Security exception log).
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'sha256-kLmvWqfziFavKtqHqRsb90f006UAK2Dmd0It5Iz2KFA='; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
			Cross-Origin-Opener-Policy same-origin
		}

		# The email preview frame page (spec 0009, AC-32) gets a policy written for email instead. This
		# `header` runs after the one above, so its fields replace the console's. path_regexp is case
		# sensitive, unlike `path`, so /Frames/... stays a console file with the console's headers.
		@emailPreview path_regexp ^/frames/email-preview\.html$
		handle @emailPreview {
			header {
				import email-preview-headers.caddy
			}
			file_server
		}

		# Hashed build files never change, so a file that exists caches for a year. A missing one is a
		# plain 404 that is never cached: falling back to index.html would let a browser keep HTML as
		# JavaScript for a year (for example a chunk from the previous build).
		handle /assets/* {
			@hit file {path}
			header @hit Cache-Control "public, max-age=31536000, immutable"
			@miss not file {path}
			header @miss Cache-Control "no-cache"
			file_server
		}

		# Everything else (index.html, theme-init.js, and the SPA fallback that serves index.html) is
		# revalidated every time.
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
