<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to the local Orvano stack at localhost (reached through `adb reverse`), and nowhere
     else. Release builds keep Android's default, HTTPS only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
