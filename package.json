{
  "name": "orvano",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write console website && dotnet format Orvano.slnx",
    "format:check": "prettier --check console website && dotnet format Orvano.slnx --verify-no-changes",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "simple-git-hooks": "2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  }
}
