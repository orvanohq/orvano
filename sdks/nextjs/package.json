{
  "name": "@orvano/nextjs",
  "version": "0.2.0",
  "description": "Orvano for Next.js: server components, route handlers, server actions, and middleware.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orvanohq/orvano.git",
    "directory": "sdks/nextjs"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@orvano/js": "workspace:*"
  },
  "devDependencies": {
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "next": ">=15.0.0"
  }
}
