<Project>
  <!-- Spec 0002 GEN-1, GEN-2, GEN-4 and spec 0006 SUP-5. Analyzer rule severities belong in .editorconfig (spec 0008 FMT-6). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Spec 0007 IMG-1: the image publishes for both architectures, so every lock file carries both runtime graphs. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <WarningsAsErrors Condition="'$(CI)' == 'true'">$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- Spec 0008 FMT-6: IDE0005 (unused usings) needs the documentation file; the server doesn't require XML docs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <!-- Spec 0008 LNT-6: banned APIs, each line naming its rule and what to use instead. Tests inherit it. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/BannedSymbols.*.txt" />
  </ItemGroup>
  <!-- Spec 0013 CAC-5: modules invalidate the cache only through ICacheInvalidator. -->
  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('Orvano.Modules.'))">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)src/BannedSymbols.Modules.txt" />
  </ItemGroup>
</Project>
