<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Auth module (spec 0004): app users and console accounts, passwords, sessions, and token signing keys.
       Public types live only in the Contracts namespace; the host reaches the module entry point through
       InternalsVisibleTo. It reaches the Platform module only through Orvano.Platform.Contracts, and the Messaging
       module only through Orvano.Messaging.Contracts (IEmailQueue, spec 0010). -->
  <PropertyGroup>
    <RootNamespace>Orvano.Auth</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orvano.Contract\Orvano.Contract.csproj" />
    <ProjectReference Include="..\Orvano.Core\Orvano.Core.csproj" />
    <ProjectReference Include="..\Orvano.Platform\Orvano.Platform.csproj" />
    <ProjectReference Include="..\Orvano.Messaging\Orvano.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fido2" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="NSec.Cryptography" />
  </ItemGroup>

  <!-- Spec 0014, AC-7: the common password list and the disposable domain list, loaded once per process. Refreshed by
       tools/lists/refresh.mjs; their sources and licenses are in THIRD_PARTY_NOTICES.md. -->
  <ItemGroup>
    <EmbeddedResource Include="Lists\*.txt" LogicalName="Orvano.Auth.Lists.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="orvano" />
    <InternalsVisibleTo Include="Orvano.Server.Tests" />
    <InternalsVisibleTo Include="Orvano.ModelDriftCheck" />
  </ItemGroup>

</Project>
