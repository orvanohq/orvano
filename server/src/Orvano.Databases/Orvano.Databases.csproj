<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Databases module (spec 0015): each project's named databases, its tables read live from pg_catalog, and
       the data API over their rows. Public types live only in the Contracts namespace; the host reaches the module
       entry point through InternalsVisibleTo. It reaches Platform and Auth only through their Contracts, and nothing
       references it. -->
  <PropertyGroup>
    <RootNamespace>Orvano.Databases</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orvano.Contract\Orvano.Contract.csproj" />
    <ProjectReference Include="..\Orvano.Core\Orvano.Core.csproj" />
    <ProjectReference Include="..\Orvano.Platform\Orvano.Platform.csproj" />
    <ProjectReference Include="..\Orvano.Auth\Orvano.Auth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="orvano" />
    <InternalsVisibleTo Include="Orvano.Server.Tests" />
    <InternalsVisibleTo Include="Orvano.ModelDriftCheck" />
  </ItemGroup>

</Project>
