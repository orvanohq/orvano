<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Spec 0007 RUN-1: one executable named orvano. -->
    <AssemblyName>orvano</AssemblyName>
    <RootNamespace>Orvano.Host</RootNamespace>
    <VersionPrefix>0.1.0</VersionPrefix>
    <UserSecretsId>orvano-host-development</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <!-- Spec 0014 CLT-3: the OpenAPI XML comment generator reads only this project's docs unless the referenced Orvano
       projects' XML files are passed in, so module request and response records reach the contract with descriptions. -->
  <Target Name="AddOrvanoXmlDocsToOpenApi" AfterTargets="ResolveReferences">
    <ItemGroup>
      <AdditionalFiles Include="@(ReferencePath->'%(RootDir)%(Directory)%(Filename).xml')"
                       Condition="$([System.String]::Copy('%(ReferencePath.Filename)').StartsWith('Orvano.')) And Exists('%(RootDir)%(Directory)%(Filename).xml')" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- Spec 0002 TST-2: integration tests reach the host's internals. -->
    <InternalsVisibleTo Include="Orvano.Host.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orvano.Infrastructure\Orvano.Infrastructure.csproj" />
    <ProjectReference Include="..\Orvano.Modules.Auth\Orvano.Modules.Auth.csproj" />
    <ProjectReference Include="..\Orvano.SharedKernel\Orvano.SharedKernel.csproj" />
  </ItemGroup>
</Project>
