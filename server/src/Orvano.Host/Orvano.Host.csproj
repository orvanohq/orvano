<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Spec 0007 RUN-1: one executable named orvano. -->
    <AssemblyName>orvano</AssemblyName>
    <RootNamespace>Orvano.Host</RootNamespace>
    <VersionPrefix>0.1.0</VersionPrefix>
    <UserSecretsId>orvano-host-development</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <!-- Spec 0014 CLT-3: the OpenAPI XML comment generator reads only this project's docs unless the referenced Orvano
       projects' XML files are passed in, so module request and response records reach the contract with descriptions. -->
  <Target Name="AddOrvanoXmlDocsToOpenApi" AfterTargets="ResolveReferences">
    <ItemGroup>
      <AdditionalFiles Include="@(ReferencePath->'%(RootDir)%(Directory)%(Filename).xml')"
                       Condition="$([System.String]::Copy('%(ReferencePath.Filename)').StartsWith('Orvano.')) And Exists('%(RootDir)%(Directory)%(Filename).xml')" />
    </ItemGroup>
  </Target>
  <!-- Spec 0016 BND-1: `orvano init` reads its bundle from install/ beside the executable. The image copies it there from
       deploy/ itself; these links give local runs and the tests the same files. The image's build stage has no deploy/,
       so the condition keeps them out of a published image. -->
  <ItemGroup Condition="Exists('..\..\..\deploy\compose.yaml')">
    <None Include="..\..\..\deploy\compose.yaml;..\..\..\deploy\Caddyfile" Link="install\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="..\..\..\deploy\postgres-init\10-orvano-roles.sh" Link="install\postgres-init\10-orvano-roles.sh"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <!-- Spec 0002 TST-2: integration tests reach the host's internals. -->
    <InternalsVisibleTo Include="Orvano.Host.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orvano.Infrastructure\Orvano.Infrastructure.csproj" />
    <ProjectReference Include="..\Orvano.Modules.Auth\Orvano.Modules.Auth.csproj" />
    <ProjectReference Include="..\Orvano.SharedKernel\Orvano.SharedKernel.csproj" />
  </ItemGroup>
</Project>
