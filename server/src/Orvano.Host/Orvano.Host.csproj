<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Spec 0007 RUN-1: one executable named orvano. -->
    <AssemblyName>orvano</AssemblyName>
    <RootNamespace>Orvano.Host</RootNamespace>
    <VersionPrefix>0.1.0</VersionPrefix>
    <UserSecretsId>orvano-host-development</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <!-- Spec 0002 TST-2: integration tests reach the host's internals. -->
    <InternalsVisibleTo Include="Orvano.Host.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orvano.Infrastructure\Orvano.Infrastructure.csproj" />
    <ProjectReference Include="..\Orvano.Modules.Auth\Orvano.Modules.Auth.csproj" />
    <ProjectReference Include="..\Orvano.SharedKernel\Orvano.SharedKernel.csproj" />
  </ItemGroup>
</Project>
