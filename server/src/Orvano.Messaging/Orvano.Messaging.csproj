<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Messaging module (spec 0009): SMTP settings per project, email templates, and the send queue.
       Public types live only in the Contracts namespace; the host reaches the module entry point through
       InternalsVisibleTo. It reaches the Platform module only through Orvano.Platform.Contracts, and never
       references Auth, so Auth can reference it. -->
  <PropertyGroup>
    <RootNamespace>Orvano.Messaging</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orvano.Contract\Orvano.Contract.csproj" />
    <ProjectReference Include="..\Orvano.Core\Orvano.Core.csproj" />
    <ProjectReference Include="..\Orvano.Platform\Orvano.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fluid.Core" />
    <PackageReference Include="MailKit" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="orvano" />
    <InternalsVisibleTo Include="Orvano.Server.Tests" />
    <InternalsVisibleTo Include="Orvano.ModelDriftCheck" />
  </ItemGroup>

</Project>
