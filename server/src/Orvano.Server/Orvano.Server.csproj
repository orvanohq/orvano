<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The binary is `orvano`, so containers run `orvano api`, `orvano healthcheck`, ... -->
    <AssemblyName>orvano</AssemblyName>
    <RootNamespace>Orvano.Server</RootNamespace>
    <UserSecretsId>orvano-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\migrations\platform\*.sql" LogicalName="migrations/platform/%(Filename)%(Extension)" />
    <!-- `orvano install` writes these into the install directory, so the compose file always
         matches the version of the image that wrote it (spec 0006). -->
    <EmbeddedResource Include="..\..\..\deploy\compose\docker-compose.yml" LogicalName="install/docker-compose.yml" />
    <EmbeddedResource Include="..\..\..\deploy\compose\initdb\10-orvano-roles.sh" LogicalName="install/initdb/10-orvano-roles.sh" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orvano.Auth\Orvano.Auth.csproj" />
    <ProjectReference Include="..\Orvano.Contract\Orvano.Contract.csproj" />
    <ProjectReference Include="..\Orvano.Core\Orvano.Core.csproj" />
    <ProjectReference Include="..\Orvano.Messaging\Orvano.Messaging.csproj" />
    <ProjectReference Include="..\Orvano.Platform\Orvano.Platform.csproj" />
  </ItemGroup>

  <!-- The host exposes no public API; its types are internal and only the tests reach in. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Orvano.Server.Tests" />
    <InternalsVisibleTo Include="Orvano.ModelDriftCheck" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
