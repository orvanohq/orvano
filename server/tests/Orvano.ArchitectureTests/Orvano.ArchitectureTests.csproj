<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the project reference rules from spec 0001. References no repo project on purpose:
       it reads every .csproj and each project's obj/project.assets.json (written by restore). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
