{
  "openapi": "3.1.1",
  "info": {
    "title": "Orvano API",
    "description": "The Orvano API that the client and server SDKs call. Send the version in `Orvano-Api-Version`; every error is a problem body with a `code`.",
    "license": {
      "name": "Apache 2.0",
      "identifier": "Apache-2.0"
    },
    "version": "2026-10-22"
  },
  "paths": {
    "/v1/projects/{projectId}/samples": {
      "post": {
        "tags": [
          "samples"
        ],
        "summary": "Create a sample.",
        "description": "Creates a sample and returns it.",
        "operationId": "Sample_Create",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "description": "The project's ID.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSampleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SampleResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "An error. The code says which one; x-orvano-error-codes describes every code.",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              },
              "Retry-After": {
                "$ref": "#/components/headers/Retry-After"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-orvano-audience": [
          "client"
        ],
        "x-orvano-errors": [
          "conflict"
        ],
        "x-orvano-metered": "samples.create",
        "x-orvano-sdk": {
          "service": "samples",
          "method": "create"
        }
      },
      "get": {
        "tags": [
          "samples"
        ],
        "summary": "List samples.",
        "description": "Returns the samples, a page at a time.",
        "operationId": "Sample_List",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "description": "The project's ID.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "How many items to return, 1 to 100; 50 when not sent.",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "The nextCursor of the previous page; omit it for the first page.",
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageOfSampleResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "An error. The code says which one; x-orvano-error-codes describes every code.",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              },
              "Retry-After": {
                "$ref": "#/components/headers/Retry-After"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-orvano-audience": [
          "server"
        ],
        "x-orvano-errors": [
          "invalid_cursor"
        ],
        "x-orvano-paging": {
          "total": false
        },
        "x-orvano-sdk": {
          "service": "samples",
          "method": "list"
        }
      }
    },
