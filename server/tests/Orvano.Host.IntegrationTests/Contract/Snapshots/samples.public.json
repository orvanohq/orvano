        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              }
