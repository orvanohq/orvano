            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "An error. The code says which one; x-orvano-error-codes describes every code.",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              },
              "Retry-After": {
                "$ref": "#/components/headers/Retry-After"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-orvano-audience": [
          "server"
        ],
        "x-orvano-errors": [
          "not_found"
        ],
        "x-orvano-sdk": {
          "service": "samples",
          "method": "get"
        },
        "x-orvano-sdk-template": "typed-rows"
      },
      "patch": {
        "tags": [
          "samples"
        ],
        "summary": "Update a sample.",
        "description": "Changes the fields sent and leaves the rest.",
        "operationId": "Sample_Update",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "description": "The project's ID.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sampleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/If-Match"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSampleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionedSampleResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "412": {
            "description": "Precondition Failed",
            "headers": {
              "Orvano-Request-Id": {
                "$ref": "#/components/headers/Orvano-Request-Id"
              },
              "Orvano-Api-Version": {
                "$ref": "#/components/headers/Orvano-Api-Version"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
