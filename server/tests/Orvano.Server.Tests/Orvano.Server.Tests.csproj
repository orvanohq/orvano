<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit and integration tests for the server scaffold (spec 0002). Integration tests start one
       Postgres 18 container through Testcontainers and give each test its own database, so Docker
       must be running. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Orvano.Server\Orvano.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
