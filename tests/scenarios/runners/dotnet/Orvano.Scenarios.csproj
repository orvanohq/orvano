<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the shared scenarios through the Orvano .NET SDK (spec 0001, AC-10, AC-13). The net8.0
       build gets the SDK's netstandard2.0 assembly, so both SDK targets are exercised; RollForward
       lets it run on a machine that has only a newer runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework />
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <RootNamespace>Orvano.Scenarios</RootNamespace>
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
    <!-- A test tool, not an API to document. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\sdks\dotnet\src\Orvano\Orvano.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
