{
  "name": "orvano-sdk-repo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.12.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "prepare": "node tooling/scripts/prepare.mjs",
    "check": "vp check && eslint --max-warnings=0 && pnpm -r typecheck",
    "fix": "vp check --fix && eslint --fix",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "size": "size-limit"
  },
  "devDependencies": {
    "@size-limit/esbuild": "14.2.0",
    "@size-limit/file": "14.2.0",
    "eslint": "10.12.0",
    "eslint-plugin-oxlint": "1.87.0",
    "jiti": "2.7.0",
    "size-limit": "14.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vite-plus": "1.3.0"
  }
}
