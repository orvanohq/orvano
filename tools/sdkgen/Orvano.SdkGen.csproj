<Project Sdk="Microsoft.NET.Sdk">

  <!-- Orvano SdkGen (spec 0001): reads contract/dist/openapi.json and writes the generated layer of
       every SDK, the server contract types, and the scenario dispatch tables. Run it from anywhere
       in the repo: `dotnet run` with this project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Orvano.SdkGen</RootNamespace>
    <AssemblyName>orvano-sdkgen</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Scriban" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="templates\**\*.scriban" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orvano.SdkGen.Tests" />
  </ItemGroup>

</Project>
