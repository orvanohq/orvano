// {{ header }}
{{~ if uses_globalization ~}}
using System.Globalization;
{{~ end ~}}

namespace {{ namespace }};
{{~ for s in services ~}}

/// <summary>Operations in the <c>{{ s.name }}</c> service.</summary>
public sealed class {{ s.class_name }}
{
    private readonly OrvanoClient _client;

    /// <summary>Creates the service over <paramref name="client"/>.</summary>
    /// <param name="client">The client every call sends through.</param>
    {{ constructor_visibility }} {{ s.class_name }}(OrvanoClient client) => _client = client;
{{~ for o in s.operations ~}}

    /// <summary>{{ o.summary }}</summary>
{{~ for d in o.param_docs ~}}
    /// {{ d }}
{{~ end ~}}
    public {{ o.signature }} =>
        {{ o.body }};
{{~ end ~}}
}
{{~ end ~}}
{{~ if partial_client ~}}

public sealed partial class OrvanoClient
{
{{~ for s in services ~}}
    private {{ s.class_name }}? {{ s.field }};
{{~ end ~}}
{{~ for s in services ~}}

    /// <summary>Operations in the <c>{{ s.name }}</c> service.</summary>
    public {{ s.class_name }} {{ s.property }} => {{ s.field }} ??= new {{ s.class_name }}(this);
{{~ end ~}}
}
{{~ end ~}}
