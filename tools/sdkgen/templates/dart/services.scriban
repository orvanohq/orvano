// {{ header }}
{{~ for i in imports ~}}
{{ i }}
{{~ end ~}}
{{~ for s in services ~}}

/// Operations in the `{{ s.name }}` service.
final class {{ s.class_name }} {
  /// Creates the service over [client].
  {{ s.class_name }}(this._client);

  final Client _client;
{{~ for o in s.operations ~}}

{{ o.doc }}  {{ o.signature }} {{ o.body }}
{{~ end ~}}
}
{{~ end ~}}

{{ aggregate.doc }}{{ if aggregate.base }}final{{ else }}base{{ end }} class {{ aggregate.name }}{{ if aggregate.base }} extends {{ aggregate.base }}{{ end }} {
  /// Creates the services over [client].
{{~ if aggregate.base ~}}
  {{ aggregate.name }}(super.client){{ if aggregate.services.size > 0 }} : {{ for s in aggregate.services }}{{ s.property }} = {{ s.class_name }}(client){{ if !for.last }}, {{ end }}{{ end }}{{ end }};
{{~ else ~}}
  {{ aggregate.name }}(this.client){{ if aggregate.services.size > 0 }} : {{ for s in aggregate.services }}{{ s.property }} = {{ s.class_name }}(client){{ if !for.last }}, {{ end }}{{ end }}{{ end }};

  /// The client every service sends through.
  final Client client;
{{~ end ~}}
{{~ for s in aggregate.services ~}}

  /// Operations in the `{{ s.name }}` service.
  final {{ s.class_name }} {{ s.property }};
{{~ end ~}}
}
