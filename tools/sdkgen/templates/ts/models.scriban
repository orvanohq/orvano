// {{ header }}
{{~ for i in imports ~}}
{{ i }}
{{~ end ~}}
{{~ if catalog ~}}

{{ catalog.doc }}export const {{ catalog.name }} = {
{{~ for c in catalog.codes ~}}
{{ c.doc }}  {{ c.name }}: {{ c.value }},
{{~ end ~}}
} as const

/** One of the codes in {@link {{ catalog.name }}}. */
export type {{ catalog.name }} = (typeof {{ catalog.name }})[keyof typeof {{ catalog.name }}]
{{~ end ~}}
{{~ for e in enums ~}}

{{ e.doc }}export type {{ e.name }} = {{ e.union }}
{{~ end ~}}
{{~ for m in models ~}}

{{ m.doc }}export interface {{ m.name }} {
{{~ for p in m.properties ~}}
{{ p.doc }}  {{ p.declaration }}
{{~ end ~}}
}
{{~ end ~}}
{{~ if enums.size == 0 && models.size == 0 && !catalog ~}}

export {}
{{~ end ~}}
