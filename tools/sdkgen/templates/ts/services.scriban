// {{ header }}
{{~ for i in imports ~}}
{{ i }}
{{~ end ~}}
{{~ for s in services ~}}

/** Operations in the `{{ s.name }}` service. */
export class {{ s.class_name }} {
  readonly #client: Client

  constructor(client: Client) {
    this.#client = client
  }
{{~ for o in s.operations ~}}

{{ o.doc }}  {{ o.signature }} {
    {{ o.body }}
  }
{{~ end ~}}
}
{{~ end ~}}

{{ aggregate.doc }}export class {{ aggregate.name }}{{ if aggregate.base }} extends {{ aggregate.base }}{{ end }} {
{{~ if !aggregate.base ~}}
  /** The client every service sends through. */
  readonly client: Client
{{~ end ~}}
{{~ for s in services ~}}
  /** Operations in the `{{ s.name }}` service. */
  readonly {{ s.property }}: {{ s.class_name }}
{{~ end ~}}

  constructor(client: Client) {
{{~ if aggregate.base ~}}
    super(client)
{{~ else ~}}
    this.client = client
{{~ end ~}}
{{~ for s in services ~}}
    this.{{ s.property }} = new {{ s.class_name }}(client)
{{~ end ~}}
  }
}
