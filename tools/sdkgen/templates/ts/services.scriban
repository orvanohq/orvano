// {{ header }}
import type { Client } from '../runtime/client.js'
{{~ if model_imports != "" ~}}
import type { {{ model_imports }} } from './models.js'
{{~ end ~}}
{{~ for s in services ~}}

/** Operations in the `{{ s.name }}` service. */
export class {{ s.class_name }} {
  readonly #client: Client

  constructor(client: Client) {
    this.#client = client
  }
{{~ for o in s.operations ~}}

{{ o.doc }}  {{ o.name }}({{ o.params }}): Promise<{{ o.result }}> {
    return this.#client.request<{{ o.result }}>({{ o.request }})
  }
{{~ end ~}}
}
{{~ end ~}}

/** Every service in this entry, on one object: `orvano.health.get()`. */
export class Orvano {
  /** The client every service sends through. */
  readonly client: Client
{{~ for s in services ~}}
  /** Operations in the `{{ s.name }}` service. */
  readonly {{ s.property }}: {{ s.class_name }}
{{~ end ~}}

  constructor(client: Client) {
    this.client = client
{{~ for s in services ~}}
    this.{{ s.property }} = new {{ s.class_name }}(client)
{{~ end ~}}
  }
}
