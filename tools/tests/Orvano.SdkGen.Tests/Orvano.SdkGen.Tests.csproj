<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for SdkGen (spec 0001): contract rules, the public contract, version stamping,
       docs snippets, and type mapping. No Docker, no formatters: they call the generator's
       stages directly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test classes are public for xUnit, not an API to document. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdkgen\Orvano.SdkGen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
