    "astro": "^7.3.5",
    "github-slugger": "^2.0.0",
    "sharp": "^0.35.5",
    "starlight-links-validator": "^0.26.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-openapi": "^0.26.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.13.3",
    "hast-util-select": "^6.0.4",
    "playwright": "1.63.0",
