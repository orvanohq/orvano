# Security headers on every response (spec 0011, AC-23). scripts/headers.ts adds the Content Security Policy to the
# `/*` rule after the build, with the hashes of the inline scripts it finds in the built pages.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
