// orvano.dev on Cloudflare Workers static assets (spec 0011, AC-23). No Worker code: Cloudflare serves `dist/`,
// applies `public/_headers`, and answers an unknown path with the site's 404 page.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orvano-website",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // `wrangler deploy` (release.yml, or a manual website.yml run) attaches orvano.dev as a Custom Domain, which needs
  // the zone on Cloudflare and no other A, AAAA, or CNAME record on the apex. `www` redirects to it through a
  // Redirect Rule set in the dashboard (`_redirects` can't match a host).
  "routes": [{ "pattern": "orvano.dev", "custom_domain": true }],
  // Pull request previews are `wrangler versions upload --preview-alias pr-<number>` (AC-26), served at
  // `pr-<number>-orvano-website.<account subdomain>.workers.dev`.
  "workers_dev": true,
  "preview_urls": true,
}
